# === MongoDB (TV1 - Source of Truth) ===
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=cinevault

# === Auth & Security (TV1) ===
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# === Neo4j (TV2 - Graph Recommendation) ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cinevault_neo4j_pass

# === Redis (TV3 - Cache, Trending, Rate Limit, Blacklist) ===
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=1.0

# === App / CORS ===
APP_NAME=Titofilm API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_MOVIE_LIMIT=2000
SEED_USER_COUNT=220
SEED_REVIEW_TARGET=8800

# === Tito Concierge AI (Optional — Free key at AI Studio or Groq) ===
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
